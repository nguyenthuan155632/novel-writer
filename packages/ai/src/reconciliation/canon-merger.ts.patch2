--- packages/ai/src/reconciliation/canon-merger.ts
+++ packages/ai/src/reconciliation/canon-merger.ts
@@ -107,6 +107,17 @@
       for (const seedId of params.seedsResolvedIds) {
+        const existingSeedRows = await this.deps.db.select({
+          id: plantedSeeds.id,
+          plantedInChapter: plantedSeeds.plantedInChapter,
+        }).from(plantedSeeds).where(and(eq(plantedSeeds.id, seedId), eq(plantedSeeds.storyId, params.storyId)));
+        
+        const existingSeed = existingSeedRows[0];
+        if (!existingSeed || existingSeed.plantedInChapter == null || existingSeed.plantedInChapter > params.chapterNumber) {
+            throw new Error(`Seed ${seedId} cannot be marked paid_off before it is planted`);
+        }
         await this.applyRow({
           updateType: 'update',
           targetTable: 'planted_seeds',
           targetId: seedId,
           payload: { status: 'paid_off', paidOffAtChapter: params.chapterNumber },
         }, params.storyId, params.chapterNumber, params.traceId);
         autoAppliedCount++;
