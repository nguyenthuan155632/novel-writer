OPENCODE_API_KEY=your_opencode_api_key
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENROUTER_API_KEY=your_openrouter_api_key_for_embeddings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama (when Ollama is the active provider in Admin). Default API root includes /v1.
# No API key required for default local Ollama; set OLLAMA_API_KEY only if you use a proxy that expects Bearer auth.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novel_factory
REDIS_URL=redis://localhost:6379
WEB_BASE_URL=http://localhost:3000
API_PORT=4000

# Worker: log full LLM chat messages (system/user) for each LLM step in generate-chapter (very verbose).
# LOG_LLM_PROMPTS=1
