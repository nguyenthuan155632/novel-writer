# Database
DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_factory

# Active LLM provider + model routes: PostgreSQL (Admin + header). Not env-driven.
# Deprecated — ignored at runtime after DB-backed settings:
# NOVEL_LLM_PROVIDER=opencode

# OpenCode Go (required when OpenCode is the active provider)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# OpenRouter (required when OpenRouter is the active provider and for chapter-generation retrieval)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Novel Writer

# Ollama local (when Ollama is the active provider in Admin). No key needed for default install.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# Web
NEXT_PUBLIC_API_BASE=http://localhost:4000

# API
API_PORT=4000

# Optional: force mock LLM in any process (use for offline dev)
# NOVEL_FORCE_MOCK_LLM=1
# NOVEL_MOCK_LLM_RESPONSE='{"world_rules":"...", ... full bible JSON ...}'

# Model routes: use /admin (persisted in Postgres). Deprecated — ignored at runtime:
# BIBLE_MODEL=… SAGA_PLANNER_MODEL=… ARC_PLANNER_MODEL=… PACKET_MODEL=… WRITER_MODEL=…
# FIXER_MODEL=… VALIDATOR_MODEL=… EXTRACTOR_MODEL=… COMPACTOR_MODEL=… HIGH_STAKES_MODEL=…

# Redis
REDIS_URL=redis://localhost:6379

# Worker: log full LLM chat messages (system/user) for each LLM step in generate-chapter (very verbose).
# LOG_LLM_PROMPTS=1