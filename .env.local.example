# Database
DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_factory

# LLM provider switcher. Defaults to opencode.
NOVEL_LLM_PROVIDER=opencode

# OpenCode Go (required when selected for real LLM calls)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# OpenRouter (required when selected for real LLM calls and for chapter-generation retrieval)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Novel Writer

# Web
NEXT_PUBLIC_API_BASE=http://localhost:4000

# API
API_PORT=4000

# Optional: force mock LLM in any process (use for offline dev)
# NOVEL_FORCE_MOCK_LLM=1
# NOVEL_MOCK_LLM_RESPONSE='{"world_rules":"...", ... full bible JSON ...}'

# Model overrides (defaults are in packages/core/src/config/models.ts)
# BIBLE_MODEL=glm-5.1
# WRITER_MODEL=glm-5.1

# Redis
REDIS_URL=redis://localhost:6379
